# /opt/voc-llm/.env (권한 600). 값에 공백이나 특수문자가 있으면 작은따옴표로 감싼다.
DOMAIN=llm-voc.example.com
CERT_EMAIL=admin@example.com
RUNPOD_API_KEY=
VLLM_API_KEY=
HF_TOKEN=
VLLM_IMAGE=vllm/vllm-openai:v0.0.0
MODEL_ID=google/gemma-4-31B-it-qat-w4a16-ct
MAX_MODEL_LEN=32768
VLLM_EXTRA_ARGS=''
SNS_TOPIC_ARN=
SNS_REGION=ap-northeast-2
# Route 53 health check ID (aws-monitoring.sh 가 만든 voc-llm-healthz). EC2 가 꺼져 있는 동안 감시를 끄는 데 쓴다
HEALTH_CHECK_ID=
# 공공데이터포털 '한국천문연구원_특일 정보' 일반 인증키 (Decoding 값)
HOLIDAY_API_KEY=

# 일일 가동 기록 메일(daily-report.sh) 마지막 날짜 YYYY-MM-DD. 비우면 보내지 않는다
DAILY_REPORT_UNTIL=
