# cp infra/aws.env.example infra/aws.env 후 값 입력 (aws.env 는 git 제외)
AWS_PROFILE=kimdohyun           # 관리자 권한 프로필 (프로비저닝 후에는 voc-llm 프로필로 운영)
REGION=ap-northeast-2
KEY_NAME=voc-llm-key            # 없으면 생성하고 infra/voc-llm-key.pem 에 저장
ADMIN_CIDR=203.0.113.10/32      # 관리자 공인 IP
CUSTOMER_CIDR=                  # 고객사 VOC 서버 공인 IP (예: 198.51.100.20/32). 비우면 나중에 추가
ALERT_EMAIL=ops@example.com     # 알림 수신 메일
DOMAIN=                         # 예: llm-voc.example.com. 정해지면 입력
